# Example systemd unit: start the scanner with Bluetooth at boot.
# Install:  sudo cp hardware/smartcart_ble/tools/smartcart-scanner.service /etc/systemd/system/
#           (edit WorkingDirectory/ExecStart to your checkout and engine path)
#           sudo systemctl daemon-reload && sudo systemctl enable --now smartcart-scanner
# Logs:     journalctl -u smartcart-scanner -f
# For app testing without the camera, swap ExecStart for:
#   /usr/bin/python3 -m hardware.smartcart_ble.tools.fake_cart --demo
[Unit]
Description=SmartCart scanner (TensorRT) with Bluetooth transport
After=bluetooth.service
Requires=bluetooth.service

[Service]
Type=simple
WorkingDirectory=/home/nvidia/calhacks
ExecStart=/usr/bin/python3 -m hardware.main_tensorrt --transport ble+console --engine hardware/models/yolov8n_fp16.engine
# root is the simplest way to talk to org.bluez; alternatively User=<you> with that user in group 'bluetooth'
User=root
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
